<?xml version="1.0" encoding="utf-8"?>
<!--
  Stand-in for com.android.systemui:drawable/ic_trophy, the icon of the Android 17
  empty-shade trophy.

  Path data copied from AOSP SystemUI res/drawable/notif_footer_btn_history.xml
  (Apache-2.0), so the empty shade shows the icon of the thing that area actually
  opens: notification history.

  Deliberately monochrome. The shade's ImageView tints this drawable with
  color/materialColorOnSurface and EmptyShadeIconView.setContentColor() re-applies
  the framework's materialColorOnSurface, both of which have night variants, so the
  colour follows light/dark and wallpaper-based theming on its own. Do not add a
  tint attribute here: ?attr/... resolves against the overlay package, not the
  target, and aapt2 refuses to link it.

  It must keep at least one <path>. A <vector> with no <path> throws
  "no path defined" from VectorDrawable, which crashes the layout that inflates it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
